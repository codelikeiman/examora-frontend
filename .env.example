# ============================================================
# Examora CBT — Frontend Environment Variables
# Salin ke .env.local untuk development lokal
# ============================================================

# URL backend API (digunakan oleh Vite proxy di development)
VITE_API_BASE_URL=http://localhost:4000

# Nama aplikasi (tampil di tab browser)
VITE_APP_NAME=Examora CBT

# Versi aplikasi
VITE_APP_VERSION=1.0.0
